#!/usr/bin/env bash
# tester-env CLI for the Leantime fork deployment overlay (fork root).
#
# Image policy: IMAGE_TAG is exported by scripts/rl-env as a
# content-addressed tag so identical (baseline, patch-set) combos share an
# image. Manual invocations default to tester-env-leantime:dev. RUN_ID scopes
# ONLY containers/volumes/networks (via the compose project name), never the
# image name.
#
# Usage: ./tester-env <command> [--run-id <id>] [--port <port>]
# Commands: build, deploy, seed, verify, reset, stop, status, logs, help
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="docker-compose.tester-env.yml"

RUN_ID="${RUN_ID:-default}"
PORT="${PORT:-5080}"
ADMIN_EMAIL="admin@tester-env.local"
ADMIN_PASSWORD="TesterEnv123!"

usage() {
  cat <<EOF
Leantime - Tester Environment CLI

Usage: ./tester-env <command> [--run-id <id>] [--port <port>]

Commands:
  build    Build the editable-source Leantime app image
  deploy   Start MySQL/app, install dependencies/assets, and create admin user
  seed     Load deterministic Northstar Digital project-management data
  verify   Check stable DB counts and HTTP-rendered seeded UI text
  reset    Remove this run's containers and MySQL volume (image kept)
  stop     Stop this run's containers without deleting the database volume
  status   Show this run's compose status
  logs     Show app logs (or pass service name)
  help     Show this help message

Options:
  --run-id <id>   Isolate containers, network and volume names for parallel runs.
                  Default: default (no suffix). scripts/rl-env always passes one.
  --port <port>   Host port to bind the app container to. Default: 5080
                  (or \$PORT when exported; scripts/rl-env sets both).

Env vars:
  PORT                     Host port (default 5080). The --port flag wins when
                           both are given.
  RUN_ID                   Run id scoping compose project/containers/network/
                           volume names only, never the image name.
  IMAGE_TAG                Image name/tag (default tester-env-leantime:dev; set
                           by scripts/rl-env to a content-addressed tag).
  TESTER_ENV_BROWSER_ORIGIN
                           Browser-visible origin (set by scripts/rl-env). The
                           app's absolute base URL defaults to it so redirects
                           and links stay reachable from the runner browser.
  LEAN_APP_URL             Override the app's absolute base URL (default: the
                           browser origin above, else http://localhost:\$PORT
                           for manual runs).

Local URL: http://localhost:${PORT}
Browser URL: ${TESTER_ENV_BROWSER_ORIGIN:-http://host.docker.internal:${PORT}/}
Admin: ${ADMIN_EMAIL} / ${ADMIN_PASSWORD}
EOF
}

REMAINING_ARGS=()

parse_flags() {
  REMAINING_ARGS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --run-id)
        RUN_ID="${2:?--run-id requires a value}"; shift 2 ;;
      --port)
        PORT="${2:?--port requires a value}"; shift 2 ;;
      --help|-h)
        usage; exit 0 ;;
      --*)
        echo "Unknown option: $1" >&2; usage; exit 2 ;;
      *)
        REMAINING_ARGS+=("$1"); shift ;;
    esac
  done
}

refresh_names() {
  local suffix=""
  if [[ -n "${RUN_ID}" && "${RUN_ID}" != "default" ]]; then
    suffix="-${RUN_ID}"
  fi
  PROJECT="tester-env-leantime${suffix}"
  # IMAGE_TAG set by scripts/rl-env to a content-addressed tag; manual invocations get :dev
  IMAGE_NAME="${IMAGE_TAG:-tester-env-leantime:dev}"
  LOCAL_URL="http://localhost:${PORT}"
  # Browser-Origin Contract: Leantime builds absolute URLs from LEAN_APP_URL.
  # Default it to the runner-visible origin so redirects/links stay on the
  # browser origin; manual runs fall back to http://localhost:$PORT.
  # Never override an explicitly exported LEAN_APP_URL.
  LEAN_APP_URL="${LEAN_APP_URL:-${TESTER_ENV_BROWSER_ORIGIN:-http://localhost:${PORT}}}"
  BROWSER_URL="${TESTER_ENV_BROWSER_ORIGIN:-http://host.docker.internal:${PORT}/}"
  export IMAGE_NAME PORT LEAN_APP_URL
}

compose() {
  (cd "$SCRIPT_DIR" && docker compose -p "$PROJECT" -f "$COMPOSE_FILE" "$@")
}

mysql_exec() {
  compose exec -T mysql mysql -uleantime -pleantime leantime "$@"
}

wait_http() {
  for _ in $(seq 1 90); do
    if curl -fsS "$LOCAL_URL/auth/login" >/dev/null || curl -fsS "$LOCAL_URL/install" >/dev/null; then
      return 0
    fi
    sleep 2
  done
  echo "Leantime did not become reachable at $LOCAL_URL" >&2
  return 1
}

ensure_assets() {
  compose exec -T app sh -lc 'test -d vendor || composer install --no-dev --no-interaction --prefer-dist'
  compose exec -T app sh -lc 'test -d node_modules || npm install'
  compose exec -T app sh -lc 'test -f public/dist/js/compiled-app.3.8.0.min.js || npx mix --production'
  compose exec -T app sh -lc 'node generateBlocklist.mjs >/dev/null 2>&1 || true'
  compose exec -T app sh -lc 'chown -R www-data:www-data storage bootstrap/cache userfiles public/userfiles 2>/dev/null || true; chmod -R ug+rwX storage bootstrap/cache userfiles 2>/dev/null || true'
}

is_installed() {
  mysql_exec -Nse "SHOW TABLES LIKE 'zp_settings';" 2>/dev/null | grep -q zp_settings
}

install_app() {
  if is_installed && [ "$(mysql_exec -Nse "SELECT COUNT(*) FROM zp_user WHERE username='$ADMIN_EMAIL' AND status='A';" 2>/dev/null)" = "1" ]; then
    return 0
  fi

  cookie="$(mktemp)"
  headers="$(mktemp)"
  trap 'rm -f "$cookie" "$headers"' RETURN

  curl -fsS -c "$cookie" -D "$headers" -o /dev/null \
    -X POST "$LOCAL_URL/install" \
    --data-urlencode 'install=1' \
    --data-urlencode "email=$ADMIN_EMAIL" \
    --data-urlencode 'firstname=Admin' \
    --data-urlencode 'lastname=Tester' \
    --data-urlencode 'company=Northstar Digital'

  invite_path="$(awk 'tolower($1)=="location:" {print $2}' "$headers" | tr -d '\r' | tail -n1)"
  if [ -z "$invite_path" ] && is_installed; then
    invite_token="$(mysql_exec -Nse "SELECT pwReset FROM zp_user WHERE username='$ADMIN_EMAIL' LIMIT 1;" 2>/dev/null || true)"
    if [ -n "$invite_token" ]; then
      invite_path="/auth/userInvite/$invite_token"
    fi
  fi
  if [ -z "$invite_path" ]; then
    echo "Install did not return invite redirect" >&2
    return 1
  fi
  if [[ "$invite_path" == http://* || "$invite_path" == https://* ]]; then
    invite_url="$invite_path"
  else
    invite_url="$LOCAL_URL$invite_path"
  fi

  curl -fsS -b "$cookie" -c "$cookie" -X POST "$invite_url" \
    --data-urlencode 'saveAccount=1' \
    --data-urlencode 'step=1' \
    --data-urlencode 'name=Admin Tester' \
    --data-urlencode 'jobTitle=QA Admin' \
    --data-urlencode "password=$ADMIN_PASSWORD" >/dev/null
  curl -fsS -b "$cookie" -c "$cookie" -X POST "$invite_url?step=2" \
    --data-urlencode 'step=2' \
    --data-urlencode 'theme=default' \
    --data-urlencode 'themeFont=Inter' >/dev/null
  curl -fsS -b "$cookie" -c "$cookie" -X POST "$invite_url?step=3" \
    --data-urlencode 'step=3' \
    --data-urlencode 'colormode=light' \
    --data-urlencode 'colorscheme=themeDefault' >/dev/null
  curl -fsS -b "$cookie" -c "$cookie" -X POST "$invite_url?step=4" \
    --data-urlencode 'step=4' \
    --data-urlencode 'daySchedule-workStart=09:00' \
    --data-urlencode 'daySchedule-lunch=12:00' \
    --data-urlencode 'daySchedule-workEnd=17:00' >/dev/null
  curl -fsS -b "$cookie" -c "$cookie" -X POST "$invite_url?step=5" \
    --data-urlencode 'step=5' >/dev/null
}

seed() {
  if ! is_installed; then
    install_app
  fi
  mysql_exec < "$SCRIPT_DIR/tester-env-seed.sql"
}

verify() {
  is_installed
  mysql_exec -Nse "
    SELECT CONCAT('projects=', COUNT(*)) FROM zp_projects WHERE id BETWEEN 100 AND 102;
    SELECT CONCAT('tickets=', COUNT(*)) FROM zp_tickets WHERE id BETWEEN 100 AND 109;
    SELECT CONCAT('users=', COUNT(*)) FROM zp_user WHERE id BETWEEN 100 AND 102;
    SELECT CONCAT('sprints=', COUNT(*)) FROM zp_sprints WHERE id BETWEEN 100 AND 102;
    SELECT CONCAT('timesheets=', COUNT(*)) FROM zp_timesheets WHERE id BETWEEN 100 AND 102;
    SELECT CONCAT('comments=', COUNT(*)) FROM zp_comment WHERE id BETWEEN 100 AND 102;
    SELECT CONCAT('no_milestone_tickets=', COUNT(*)) FROM zp_tickets WHERE projectId=100 AND type<>'milestone' AND (milestoneid IS NULL OR milestoneid=0);
    SELECT CONCAT('onboarding_settings=', COUNT(*)) FROM zp_settings WHERE \`key\` IN ('companysettings.completedOnboarding', 'user.1.firstLoginCompleted') AND \`value\`='true';
    SELECT GROUP_CONCAT(CONCAT(headline, ':', status) ORDER BY id SEPARATOR ' | ') FROM zp_tickets WHERE id BETWEEN 101 AND 105;
  "

  cookie="$(mktemp)"
  headers="$(mktemp)"
  page="$(mktemp)"
  filtered="$(mktemp)"
  trap 'rm -f "$cookie" "$headers" "$page" "$filtered"' RETURN
  curl -fsS -c "$cookie" "$LOCAL_URL/auth/login" >/dev/null
  curl -fsS -b "$cookie" -c "$cookie" -D "$headers" -o /dev/null \
    -X POST "$LOCAL_URL/auth/login" \
    --data-urlencode "username=$ADMIN_EMAIL" \
    --data-urlencode "password=$ADMIN_PASSWORD" \
    --data-urlencode 'redirectUrl=/dashboard/home'
  if ! awk 'tolower($1)=="location:" {print $2}' "$headers" | tr -d '\r' | grep -q '/dashboard/home'; then
    echo "Login did not redirect to dashboard" >&2
    return 1
  fi
  curl -fsS -b "$cookie" -L "$LOCAL_URL/dashboard/home" > "$page"
  curl -fsS -b "$cookie" -L "$LOCAL_URL/projects/showAll" >> "$page"
  curl -fsS -b "$cookie" -L "$LOCAL_URL/tickets/showTicket/101" >> "$page"
  curl -fsS -b "$cookie" -L "$LOCAL_URL/tickets/showTicket/103" >> "$page"
  curl -fsS -b "$cookie" -L "$LOCAL_URL/tickets/showTicket/105" >> "$page"
  curl -fsS -b "$cookie" -L "$LOCAL_URL/tickets/showAll?projectId=100&milestone=0" > "$filtered"

  for expected in \
    'Checkout Reliability Launch' \
    'Mobile Onboarding Refresh' \
    'Reconcile duplicate payment webhook events' \
    'Blocked: tax service timeout fallback' \
    'Document checkout incident runbook' \
    'Audit expired-card error copy'; do
    if ! grep -Fq "$expected" "$page"; then
      echo "Missing visible seeded text in HTTP-rendered pages: $expected" >&2
      return 1
    fi
  done

  if ! grep -Fq 'Audit expired-card error copy' "$filtered"; then
    echo "Not-assigned milestone filter does not list the seeded no-milestone ticket" >&2
    return 1
  fi
  if grep -Fq 'Reconcile duplicate payment webhook events' "$filtered"; then
    echo "Not-assigned milestone filter still lists a milestone-assigned ticket" >&2
    return 1
  fi
  if grep -Fq 'helperController.firstLoginModal()' "$page"; then
    echo "First-run onboarding task modal still renders after seed" >&2
    return 1
  fi
  if grep -Fq "showHelperModal('home'" "$page"; then
    echo "Dashboard onboarding tour modal still renders after seed" >&2
    return 1
  fi
  echo "HTTP-visible seeded text verified at $LOCAL_URL (browser URL: $BROWSER_URL)"
}

cmd_deploy() {
  echo "==> Building image ${IMAGE_NAME} and starting stack for project '${PROJECT}' on host port ${PORT}"
  compose up -d --build
  wait_http
  ensure_assets
  wait_http
  install_app
  echo "==> Deployment complete. Local: $LOCAL_URL Browser: $BROWSER_URL"
}

cmd_reset() {
  echo "==> Removing containers and volumes for project '${PROJECT}' only (image kept)"
  compose down -v --remove-orphans
  echo "Clean slate. Run './tester-env deploy' to start fresh."
}

cmd_stop() {
  echo "==> Stopping containers for project '${PROJECT}' (volumes preserved)"
  compose stop
  echo "Stopped."
}

cmd_status() {
  compose ps
  echo "URL: $LOCAL_URL"
}

cmd_logs() {
  compose logs --tail=200 "$@"
}

CMD="${1:-help}"
shift || true
parse_flags "$@"
if [[ ${#REMAINING_ARGS[@]} -gt 0 ]]; then
  set -- "${REMAINING_ARGS[@]}"
else
  set --
fi
refresh_names

case "${CMD}" in
  build)
    compose build app
    ;;
  deploy)
    cmd_deploy
    ;;
  seed)
    seed
    ;;
  verify)
    verify
    ;;
  reset)
    cmd_reset
    ;;
  stop)
    cmd_stop
    ;;
  status)
    cmd_status
    ;;
  logs)
    cmd_logs "${1:-app}"
    ;;
  help|--help|-h|*)
    usage
    ;;
esac
